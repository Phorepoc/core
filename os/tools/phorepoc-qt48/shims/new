// them. libstdc++ headers need std::nothrow_t / std::nothrow from it: the compilers' pre-include symcpp.h
// (kernelhwsrv/kernel/eka/compsupp/symcpp; the nothrow operators are stdnew.dll's).
#ifndef __PH_QT48_NEW_SHIM
#define __PH_QT48_NEW_SHIM
#include <e32base.h>
#include "symcpp.h"
namespace std { typedef void (*new_handler)(); }
#endif
