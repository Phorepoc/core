#include <ssm/conditionresourcetypes.rh>
#include <ssm/ssmcmd.rh>
#include <ssm/startupreason.h>

#include "ssmsubstateext.hrh"
#include "ssmdlldatadefs.rh"

// Identify command list type
UID2 KUidSsmCommandListResourceFile

// ---------------------------------------------------------------------------
// r_entry_point
// This must be the first resource
// ---------------------------------------------------------------------------
//
RESOURCE SSM_COMMAND_LIST_ROOT r_entry_point
    {
    command_list_mapping = r_map;
    }

// ---------------------------------------------------------------------------
// r_map
// Mapping of command list ids to resource ids.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_COMMAND_LIST_MAPPING r_map
    {
    mappings =
        {
        SSM_COMMANDLISTID_TO_RESOURCEID
            {
            command_list_id = ESsmStateNonCritical;
            resource_id = r_cmds;
            }
        };
    }

// ===========================================================================
// Command lists in alphabetical order
// ===========================================================================
//

// ---------------------------------------------------------------------------
// r_cmds
// ---------------------------------------------------------------------------
//
RESOURCE SSM_COMMAND_LIST r_cmds
    {
    commands =
        {
        r_cmd_connlogger,
        r_cmd_provisioning,
#ifndef SYMBIAN_EXCLUDE_SIP
        r_cmd_sipprofilesrv,
#endif // defined !SYMBIAN_EXCLUDE_SIP
        r_cmd_remotelock,
	// prio 0x7EF1
	r_cmd_activitymonitor1,
	// prio 0x7EF0
	r_cmd_devencstarter,
	// prio 0x7EEF -- PHOREPOC board (X4.79): the product's widget pre-install (RD_WIDGET_PREINSTALLER)
	r_cmd_widgetstartup
// prio 0x7EEB
#ifdef  FF_MOBILITY_MANAGEMENT_ERRORS
	,r_cmd_item_nwnotifier
#endif // FF_MOBILITY_MANAGEMENT_ERRORS
	// prio 0x7E00 -- PHOREPOC test hook (2026-10-09)
	,r_cmd_ssmtest
	// prio 0x7E01 -- PHOREPOC debug link (PinePhone): the file-service helper behind the PhoneLab Project panel
	,r_cmd_phfs
	// prio 0x7E02 -- PHOREPOC volume keys (audio-mixing-plan.md V0): media keys -> the mixer's master volume
	,r_cmd_phvolume
	// prio 0x7E03 -- PHOREPOC Applications-grid pre-warm (src/phemenuwarm): draws the launcher once so its icons are rasterised before the first Menu press
	,r_cmd_phemenuwarm
	// prio 0x7E04 -- PHOREPOC developer ttys (src/phetty): the tty daemon; exits at once when CenRep e7015904/1 = 0 (PHETTY=off)
	,r_cmd_phettyd
        };
    }

// ===========================================================================
// Command items in alphabetical order
// ===========================================================================
//

// ---------------------------------------------------------------------------
// r_cmd_activitymonitor1
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_CUSTOM_COMMAND r_cmd_activitymonitor1
    {
    priority = 0x7EF1;
    severity = ECmdCriticalSeverity;
    execution_behaviour = ESsmWaitForSignal;
    dllname = "ssmactivitycmd.dll";
    ordinal = 1; // SsmActivityCmdNewL
    retries = 2;
    dll_data = r_dlldata_activitymonitor_timeout;
    }
	
	
// ---------------------------------------------------------------------------
// r_cmd_connlogger
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_connlogger
    {
    priority = 0xFFA7;
    name = "z:\\sys\\bin\\dataconnectionlogger.exe";
    execution_behaviour = ESsmFireAndForget;
    monitor_info = r_mon_3_restarts_ignore;
    }
	

// ---------------------------------------------------------------------------
// r_cmd_widgetstartup -- PHOREPOC board (X4.79). This is the device maker's product list (the _hw list: the
// a product's own may start widgetui.exe here). S^3's RD_WIDGET_PREINSTALLER pair: WidgetStartup runs
// WidgetPreInstaller, which installs z:\data\WidgetPreInstall\* once (a first-boot flag in 1028281F).
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_APP_INFO r_cmd_widgetstartup
    {
    priority = 0x7EEF;
    name = "z:\\sys\\bin\\widgetstartup.exe";
    execution_behaviour = ESsmFireAndForget;
    background = 1; // To background
    }

// ---------------------------------------------------------------------------
// r_cmd_ssmtest -- PHOREPOC test hook (NGA G1a, 2026-10-09): a ROM built with SSM_TEST=<component key> stages
// that test EXE as ssmtest.exe (x32_rom_args.py); without it the start fails and, non-critical, is ignored.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_ssmtest
    {
    priority = 0x7E00;
    name = "z:\\sys\\bin\\ssmtest.exe";
    execution_behaviour = ESsmFireAndForget;
    }

// ---------------------------------------------------------------------------
// r_cmd_phfs -- PHOREPOC (PinePhone, 2026-10-11): src/phfs serves the debug link's file list/read/write requests
// (kernel LDD PhFs.A64). Only ROMs that carry phfs.exe have it; elsewhere the start fails and, non-critical, is ignored.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_phfs
    {
    priority = 0x7E01;
    name = "z:\\sys\\bin\\phfs.exe";
    execution_behaviour = ESsmFireAndForget;
    }

// ---------------------------------------------------------------------------
// r_cmd_phvolume -- PHOREPOC (2026-10-15): src/phvolume, the volume keys (V0, audio-mixing-plan.md 3.3): steps the
// master level (P&S KPhAudioMasterVolume) the mixer applies. Non-critical: a ROM without phvolume.exe skips it.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_phvolume
    {
    priority = 0x7E02;
    name = "z:\\sys\\bin\\phvolume.exe";
    execution_behaviour = ESsmFireAndForget;
    }

// ---------------------------------------------------------------------------
// r_cmd_phemenuwarm -- PHOREPOC (2026-10-16): src/phemenuwarm. matrixmenu is already running in the background (securitycheck list);
// this brings it forward once, after boot, so WSERV rasterises the grid icons before the first Menu press, then sends it back.
// Non-critical: a ROM without phemenuwarm.exe skips it.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_phemenuwarm
    {
    priority = 0x7E03;
    name = "z:\\sys\\bin\\phemenuwarm.exe";
    execution_behaviour = ESsmFireAndForget;
    }

// ---------------------------------------------------------------------------
// r_cmd_phettyd -- PHOREPOC (2026-10-17): src/phetty. The developer tty daemon (phettyd.exe) owns the ttys; each runs pheshell
// (eshell with its console on the tty). Non-critical: a ROM without phettyd.exe (PHETTY=exclude) skips it.
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_phettyd
    {
    priority = 0x7E04;
    name = "z:\\sys\\bin\\phettyd.exe";
    execution_behaviour = ESsmFireAndForget;
    }

// ---------------------------------------------------------------------------
// r_cmd_devencstarter
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_APP_INFO r_cmd_devencstarter
    {
    priority = 0x7EF0;
    name = "z:\\sys\\bin\\devencstarter.exe";
    execution_behaviour = ESsmWaitForSignal;
    timeout = 10000;
    background = 1; // To background
    } 
	
	
// ---------------------------------------------------------------------------
// r_cmd_provisioning
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_provisioning
    {
    priority = 0xFFA7;
    name = "z:\\sys\\bin\\provisioningsc.exe";
    execution_behaviour = ESsmFireAndForget; // -- does not call Rendezvous() --
    conditional_information = r_cond_feat_smartcardprov;
    }

// ---------------------------------------------------------------------------
// r_cmd_remotelock
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_remotelock
    {
    priority = 0xFFA7;
    name = "z:\\sys\\bin\\rlock.exe";
    execution_behaviour = ESsmFireAndForget; // -- does not call Rendezvous() --
    conditional_information = r_cond_feat_remotelock;
    monitor_info = r_mon_3_restarts_ignore;
    }

// ---------------------------------------------------------------------------
// r_cmd_sipprofilesrv
// ---------------------------------------------------------------------------
//
#ifndef SYMBIAN_EXCLUDE_SIP
RESOURCE SSM_START_PROCESS_INFO r_cmd_sipprofilesrv
    {
    priority = 0xFFA7;
    name = "z:\\sys\\bin\\sipprofilesrv.exe";
    execution_behaviour = ESsmFireAndForget; // -- does not call Rendezvous() --
    }
#endif // !SYMBIAN_EXCLUDE_SIP

	
#ifdef  FF_MOBILITY_MANAGEMENT_ERRORS
// ---------------------------------------------------------------------------
// r_cmd_item_nwnotifier
// Start list item for network notifier
// ---------------------------------------------------------------------------
//
RESOURCE SSM_START_PROCESS_INFO r_cmd_item_nwnotifier
    {
	priority = 0x7EEB;
    name = "z:\\sys\\bin\\nwnotifier.exe";
	execution_behaviour = ESsmWaitForSignal;
    retries = 3;
    }
#endif // FF_MOBILITY_MANAGEMENT_ERRORS


// ===========================================================================
// Conditional blocks in alphabetical order
// ===========================================================================
//

// ---------------------------------------------------------------------------
// r_cond_feat_remotelock
// ---------------------------------------------------------------------------
//
RESOURCE SSM_CND_FEATURE_VALUE r_cond_feat_remotelock
    {
    feature_id = KFeatureIdRemoteLock;
    }

// ---------------------------------------------------------------------------
// r_cond_feat_smartcardprov
// ---------------------------------------------------------------------------
//
RESOURCE SSM_CND_FEATURE_VALUE r_cond_feat_smartcardprov
    {
    feature_id = KFeatureIdSmartCardProv;
    }

// ---------------------------------------------------------------------------
// r_dlldata_activitymonitor_timeout
// ---------------------------------------------------------------------------
//
RESOURCE CMD_PARAM_TIMEOUT r_dlldata_activitymonitor_timeout
    {
    timeout = 2;
    }

// monitoring.rss contains resource definitions, so it may not be included
// before entry point.
#include "monitoring.rss"
