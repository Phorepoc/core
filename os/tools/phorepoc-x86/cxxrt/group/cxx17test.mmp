// cxx17test.mmp -- OURS: P0 spike (docs/phorepoc/browser-plan.md): a C++20 program on libstdc++ 13 (built from the GCC source over Open C,
// tools/phorepoc-x86/cxxrt/) -- std::string/containers/threads/exceptions. The standard-C++ part is a PREBUILT archive
// (build_libstdcxx.sh + build_cxxtest.sh -> .phorepoc-x86-build/cxxrt/*.a), linked via the registry's x32_archives.
TARGET			cxx17test.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015770
CAPABILITY		None
EPOCHEAPSIZE	0x100000 0x1000000
EPOCSTACKSIZE	0x14000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		..
SOURCE			cxxrt_main.cpp
STATICLIBRARY	libcrt0.lib
LIBRARY			libc.lib libm.lib libpthread.lib
LIBRARY			euser.lib
SMPSAFE
