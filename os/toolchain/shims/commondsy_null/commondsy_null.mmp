// commondsy_null.mmp -- OURS: null DSY for the DOS server (see commondsy_null.cpp); UIDs as the real
// dosservices/commondsy/group/CommonDSY.mmp, ordinal table = the REAL commondsy/EABI/commondsyU.DEF.
#include <platform_paths.hrh>

TARGET			commondsy.dll
TARGETTYPE		dll
UID				0x1000008D 0x101FB441

CAPABILITY		CAP_GENERAL_DLL
VENDORID		VID_DEFAULT

SOURCEPATH		.
SOURCE			commondsy_null.cpp

OS_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib dossrv.lib
