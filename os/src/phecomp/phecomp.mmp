// phecomp.mmp -- OURS: phecomp, the window compositor as an NGA window-server render stage (phecomp.cpp, README.md)
#include <platform_paths.hrh>

TARGET			phecomp.dll
TARGETTYPE		PLUGIN
UID				0x10009D8D 0xE7017C00
CAPABILITY		PowerMgmt ReadDeviceData WriteDeviceData ProtServ
VENDORID		0x70000001

MACRO			SYMBIAN_GRAPHICS_GCE
OS_LAYER_SYSTEMINCLUDE_SYMBIAN

USERINCLUDE		.
// compose mode: the 2010 std plug-in's off-screen target (RSgImage + DirectGDI) and its MWsGraphicsContext over DirectGDI (EPL)
USERINCLUDE		../../baseline/symbian-2010/oss.FCL.sf.os.graphics/windowing/windowserverplugins/openwfc/inc
SOURCEPATH		.
SOURCE			phecomp.cpp
SOURCEPATH		../../baseline/symbian-2010/oss.FCL.sf.os.graphics/windowing/windowserverplugins/openwfc/src
SOURCE			directgdigcwrapper.cpp utils.cpp

SOURCEPATH		.
START RESOURCE	E7017C00.rss
TARGET			phecomp.rsc
END

LIBRARY			euser.lib ws32.lib
LIBRARY			ecom.lib
LIBRARY			wsgraphicdrawer.lib
LIBRARY			directgdi.lib graphicsresource.lib fbscli.lib gdi.lib bitgdi.lib lookuptable.lib estor.lib

SMPSAFE
