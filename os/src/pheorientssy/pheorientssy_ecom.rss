// pheorientssy_ecom.rss -- OURS: the ECOM registration of the orientation SSY. default_data = the channel the sensor
// server lists before it loads the plug-in, in the release orientation SSY's layout (orientationssy 10282F0F.RSS)

#include <sensrvresource.hrh>
#include <ecom/registryinfov2.rh>

RESOURCE REGISTRY_INFO pheorientssy
    {
    resource_format_version = RESOURCE_FORMAT_VERSION_2;
    dll_uid = 0xE7015A20;
    interfaces =
        {
        INTERFACE_INFO
            {
            interface_uid = KSsyControlInterfaceUid;
            implementations =
                {
                BINARY_IMPLEMENTATION_INFO
                    {
                    implementation_uid = 0xE7015A21;
                    version_no         = 1;
                    display_name       = "PHEORIENTSSY";
                    default_data       = {
                                         0x1,                    // ChannelInfoVersion
                                         0x2A,                   // ChannelInfoLength
                                         0x3E,                   // Flags
                                         0x88, 0x50, 0x20, 0x10, // ChannelType: orientation
                                         0x03, 0x00, 0x00, 0x00, // ContextType: ESensrvContextTypeUser
                                         0x0C, 0x00, 0x00, 0x00, // Quantity: ESensrvQuantityOrientation
                                         0x05, 0x4e, 0x6f, 0x4c, 0x6f, 0x63, // Location: NoLoc
                                         0x08, 0x50, 0x68, 0x6f, 0x72, 0x65, 0x70, 0x6f, 0x63, // VendorId: Phorepoc
                                         0x88, 0x50, 0x20, 0x10, // ChannelDataTypeId
                                         0x01, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF // ChannelSecurityPolicy: always pass
                                         };
                    }
                };
            }
        };
    }
