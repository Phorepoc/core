// glestri.mmp -- OURS: the first OpenGL ES 2.0 program (glestri.cpp), an ordinary client of libEGL.dll +
// libGLESv2.dll (the frozen 2010 ABIs; behind them phgl.dll = Mesa on the Mali-400).
TARGET			glestri.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015770

CAPABILITY		None
VENDORID		0

EPOCHEAPSIZE	0x100000 0x4000000
EPOCSTACKSIZE	0x20000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			glestri.cpp

LIBRARY			euser.lib ws32.lib libm.lib
LIBRARY			libEGL.lib libGLESv2.lib

SMPSAFE
