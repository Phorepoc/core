+#ifdef PHE_NO_FORK
+#include <spawn.h>
+/* Phorepoc (no fork). A spawned process gets every fd of the shell (the libc hands the whole
+ * table over); the ones zsh keeps for itself (FDT_INTERNAL: pipe ends, saved copies) are
+ * closed in the child as a forked child would close them, else a reader never sees EOF.
+ * in/out (when nonzero) become the child's fds 0/1. Returns the pid, or -1. */
+static pid_t
+phe_spawn_argv(char **argv, int in, int out)
+{
+    posix_spawn_file_actions_t fa;
+    pid_t pid;
+    int r, i;
+
+    posix_spawn_file_actions_init(&fa);
+    for (i = 3; i <= max_zsh_fd; i++)
+	if (fdtable[i] == FDT_INTERNAL && i != in && i != out)
+	    posix_spawn_file_actions_addclose(&fa, i);
+    r = phe_spawn(&pid, argv[0], argv, environ, &fa, in, out);	/* port/phe_spawn.c: fds 0-2, quoting */
+    posix_spawn_file_actions_destroy(&fa);
+    if (r) {
+	if (r == ENOENT)
+	    zerr("command not found: %s", argv[0]);
+	else
+	    zerr("%s: %e", argv[0], r);
+	return -1;
+    }
+    return pid;
+}
+
+/* R3: an external command, its redirections (and pipe ends: redup moved them, closing the
+ * originals) already on fds 0-2 of the shell; phe_spawn hands those over. */
+static pid_t
+phe_spawn_cmd(LinkList args, UNUSED(int flags), int in, int out)
+{
+    char **argv = makecline(args), **ep;
+
+    for (ep = argv; *ep; ep++)
+	unmetafy(*ep, NULL);
+    (void)in; (void)out;
+    return phe_spawn_argv(argv, 0, 0);
+}
+
+/* "zsh -f -c text" on in/out; text is untokenized and metafied (it is unmetafied here). */
+static pid_t
+phe_reexec_text(char *text, int in, int out)
+{
+    char *argv[5];
+
+    unmetafy(text, NULL);
+    argv[0] = "zsh";
+    argv[1] = "-f";
+    argv[2] = "-c";
+    argv[3] = text;
+    argv[4] = NULL;
+    return phe_spawn_argv(argv, in, out);
+}
+
+/* R4: a command zsh forks before it has expanded anything (a pipeline stage that is not the
+ * last, a background job): run its source text in a fresh zsh ("re-exec"). The child sees
+ * the exported environment only -- not unexported parameters, functions, aliases or options. */
+static pid_t
+phe_reexec(Eprog prog, Wordcode beg, int in, int out)
+{
+    char *text = getpermtext(prog, beg, 0);
+    pid_t pid = phe_reexec_text(text, in, out);
+
+    zfree(text, 0);
+    return pid;
+}
