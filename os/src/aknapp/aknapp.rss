// aknapp.rss -- OURS: application resource for the minimal Avkon app
NAME AKNA

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <appinfo.rh>
#include "aknapp.hrh"

RESOURCE RSS_SIGNATURE { }
RESOURCE TBUF r_default_document_name { buf = ""; }

RESOURCE EIK_APP_INFO
	{
	menubar = r_aknapp_menubar;
	cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
	}

RESOURCE MENU_BAR r_aknapp_menubar
	{
	titles = { MENU_TITLE { menu_pane = r_aknapp_menu; } };
	}

RESOURCE MENU_PANE r_aknapp_menu
	{
	items =
		{
		MENU_ITEM { command = EAknAppCmdHello; txt = "Say hello"; },
		MENU_ITEM { command = EAknSoftkeyExit; txt = "Exit"; }
		};
	}

RESOURCE TBUF r_aknapp_hello { buf = "Hello from a from-source Symbian UI"; }

// the launcher's entry: the caption and the icon (aknapp_icon.mbm, drawn by data/make_icon.py)
RESOURCE LOCALISABLE_APP_INFO r_aknapp_localisable_app_info
	{
	short_caption = "Sample app";
	caption_and_icon = CAPTION_AND_ICON_INFO { caption = "Sample app"; number_of_icons = 1; icon_file = "\\resource\\apps\\aknapp_icon.mbm"; };
	}
