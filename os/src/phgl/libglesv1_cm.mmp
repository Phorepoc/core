// libglesv1_cm.mmp -- OURS: libGLESv1_CM.dll, the frozen OpenGL ES 1.1 Common ABI (libglesv1_cm11u.def) as a thin
// front over phgl.dll (gen/libglesv1_front.cpp, generated by mesa-symbian/gen_gl_fronts.py). Mesa's GLES1 is its
// fixed-function emulation over the same gallium driver. UID3 = KUidOpenGLESv1CommonProfileDllUidValue.
TARGET			libGLESv1_CM.dll
TARGETTYPE		dll
UID				0x1000008d 0x102836BE

CAPABILITY		All -Tcb
VENDORID		0

EPOCALLOWDLLDATA

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			phgl_front.cpp gen/libglesv1_front.cpp

LIBRARY			euser.lib

SMPSAFE
