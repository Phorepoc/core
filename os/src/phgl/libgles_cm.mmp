// libgles_cm.mmp -- OURS: libGLES_CM.dll, the older S60 OpenGL ES 1.x DLL (frozen table opengles11u.def), which S^3 ROMs
// carry next to libGLESv1_CM.dll and SDK games link (King Oddball). Its gl* go to phgl.dll like libGLESv1_CM's; it also
// exports the egl* functions, which go to libEGL.dll (gen/libgles_cm_front.cpp).
// UID3: 0x101FCABD, the identity every S^3 ROM gives libGLES_CM.dll. Executables and DLLs link it as libGLES_CM{000a0000}[101fcabd].dll;
// the loader refuses an import whose UID3 differs from the DLL's (KErrNotSupported, -5: Duomi's DmKXTAPPUTILS.dll failed to load with the old
// UID3 0x101FCABD). Executables built without the UID3 in the import name (King Oddball) load either way.
TARGET			libGLES_CM.dll
TARGETTYPE		dll
UID				0x1000008d 0x101FCABD

CAPABILITY		All -Tcb
VENDORID		0

EPOCALLOWDLLDATA

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			phgl_front.cpp gen/libgles_cm_front.cpp

LIBRARY			euser.lib

SMPSAFE
