// libglesv2.mmp -- OURS: libGLESv2.dll, the frozen OpenGL ES 2.0 ABI (libglesv2u.def) as a thin front over phgl.dll
// (gen/libglesv2_front.cpp, generated by mesa-symbian/gen_gl_fronts.py). UID = the 2010 opengles interface's.
TARGET			libGLESv2.dll
TARGETTYPE		dll
UID				0x1000008d 0x2002B6B7

CAPABILITY		All -Tcb
VENDORID		0

EPOCALLOWDLLDATA

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			phgl_front.cpp gen/libglesv2_front.cpp

LIBRARY			euser.lib

SMPSAFE
