// phgl.mmp -- OURS (GPU plan G2/G4): the Mesa backend DLL -- EGL + OpenGL ES 2.0 / 1.1 over a GL implementation a
// layer links in (its registry's EXTEND), presenting through NGA window surfaces (symgl_window.cpp). Its exports (gen/phgl.def, generated
// with the fronts) are reached ONLY through the ABI fronts libEGL.dll / libGLESv2.dll / libGLESv1_CM.dll
// (gen/*_front.cpp): no client links phgl.lib. Without one, the exports stay
// unimplemented.
TARGET			phgl.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015771

CAPABILITY		All -Tcb
VENDORID		0

EPOCALLOWDLLDATA
DEFFILE			gen/phgl.def

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		../symgl

SOURCEPATH		../symgl
// a board with a GPU swaps symgpu_null.cpp for its own channel (its registry's EXTEND table)
SOURCE			symgl_window.cpp symgpu_null.cpp

LIBRARY			libc.lib libm.lib libpthread.lib
LIBRARY			euser.lib ws32.lib gdi.lib fbscli.lib bitgdi.lib
LIBRARY			surfacemanager.lib surfaceupdateclient.lib sgresource.lib

SMPSAFE
