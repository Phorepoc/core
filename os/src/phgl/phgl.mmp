// phgl.mmp -- OURS (GPU plan G2/G4): the Mesa backend DLL -- EGL + OpenGL ES 2.0 / 1.1 over the Mali-400 (lima) or
// softpipe, presenting through NGA window surfaces (symgl_window.cpp). Its exports (gen/phgl.def, generated by
// tools/mesa/gen_gl_fronts.py) are reached ONLY through the ABI fronts libEGL.dll / libGLESv2.dll / libGLESv1_CM.dll
// (gen/*_front.cpp): no client links phgl.lib. The Mesa archives come from tools/mesa/build_mesa_symbian.py
// (emitter/components.py `phgl` arm_archives).
TARGET			phgl.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015771

CAPABILITY		All -Tcb
VENDORID		0

EPOCALLOWDLLDATA
DEFFILE			gen/phgl.def

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		../../tools/mesa/symbian/include

SOURCEPATH		../symgl
SOURCE			symgl_window.cpp symmali.cpp

LIBRARY			libc.lib libm.lib libpthread.lib
LIBRARY			euser.lib ws32.lib gdi.lib fbscli.lib bitgdi.lib
LIBRARY			surfacemanager.lib surfaceupdateclient.lib sgresource.lib

SMPSAFE
