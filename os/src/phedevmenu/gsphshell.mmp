// gsphshell.mmp -- OURS: the Control Panel (GS) plug-in "UI shell" (under Device): the
// shells installed from the Catalogue and the built-in ones, with a restart
#include <data_caging_paths.hrh>
#include <platform_paths.hrh>

CAPABILITY		CAP_ECOM_PLUGIN
TARGET			gsphshell.dll
TARGETTYPE		PLUGIN
UID				0x10009D8D 0xE7015A04
VENDORID		VID_DEFAULT

SOURCEPATH		.
SOURCE			gsphshell.cpp

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
SYSTEMINCLUDE	/epoc32/include/ecom

START RESOURCE	gsphshell_ecom.rss
TARGET			gsphshell.rsc
TARGETPATH		ECOM_RESOURCE_DIR
END

LIBRARY			euser.lib ecom.lib apparc.lib apgrfx.lib avkon.lib cone.lib eikcore.lib centralrepository.lib eikctl.lib eikcoctl.lib starterclient.lib bafl.lib efsrv.lib
LIBRARY			gsecomplugin.lib gsframework.lib
