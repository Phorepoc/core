// gsphedevmenu.mmp -- OURS: the Control Panel (GS) plug-in that lists "Developer menu" (under Device) when the
// shortcut setting is on, and starts the hidden settings app (gsphedevmenu.cpp; docs/phorepoc/devmenu.md)
#include <data_caging_paths.hrh>
#include <platform_paths.hrh>

CAPABILITY		CAP_ECOM_PLUGIN
TARGET			gsphedevmenu.dll
TARGETTYPE		PLUGIN
UID				0x10009D8D 0xE7015A02
VENDORID		VID_DEFAULT

SOURCEPATH		.
SOURCE			gsphedevmenu.cpp

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
SYSTEMINCLUDE	/epoc32/include/ecom

START RESOURCE	gsphedevmenu_ecom.rss
TARGET			gsphedevmenu.rsc
TARGETPATH		ECOM_RESOURCE_DIR
END

LIBRARY			euser.lib ecom.lib apparc.lib apgrfx.lib avkon.lib cone.lib eikcore.lib centralrepository.lib
LIBRARY			gsecomplugin.lib gsframework.lib
