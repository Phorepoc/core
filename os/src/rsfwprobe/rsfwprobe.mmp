// rsfwprobe.mmp -- OURS: a diagnosis probe for the Remote Storage Framework start (see rsfwprobe.cpp)
TARGET			rsfwprobe.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015E10
CAPABILITY		All -TCB
VENDORID		0
EPOCSTACKSIZE	0x8000

OS_LAYER_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			rsfwprobe.cpp
LIBRARY			euser.lib efsrv.lib
MW_LAYER_SYSTEMINCLUDE
