// libopenvg.mmp -- OURS: libOpenVG.dll, the real Symbian^3 name of the OpenVG 1.1 DLL (frozen ABI: openvginterface/eabi/
// libopenvg11u.def), so consumers linking libOpenVG.lib (HWVG, rendervg10, nvgdecoder) resolve unchanged. Milestone O1
//: still SOFTWARE -- it is the 2010 libopenvg_sw facade (sfopenvg/openvg/openvg.cpp,
// unmodified) over sflibopenvgrefimpl, the Khronos reference implementation. The _sw twin stays for the icon pipeline.
#include <vg/openvguids.hrh>

target          libOpenVG.dll
targettype      dll
uid             KUidSharedDllUidValue KUidOpenVGDllUidValue
CAPABILITY      ALL -tcb
vendorid        0

MACRO           __OPENVGHEADERS_USE_VG_1_1

userinclude     ../../baseline/symbian-2010/oss.FCL.sf.os.graphics/openvg/openvgrefimplementation/sfopenvg/sfopenvg/include
OS_LAYER_SYSTEMINCLUDE
OS_LAYER_LIBC_SYSTEMINCLUDE
SYSTEMINCLUDE   OS_LAYER_PUBLIC_EXPORT_PATH(vg)

sourcepath      ../../baseline/symbian-2010/oss.FCL.sf.os.graphics/openvg/openvgrefimplementation/sfopenvg/openvg
source          openvg.cpp

library         euser.lib
library         sflibopenvgrefimpl.lib

SMPSAFE
