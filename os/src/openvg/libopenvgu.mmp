// libopenvgu.mmp -- OURS: libOpenVGU.dll, the real Symbian^3 name of the VGU utility library (frozen ABI:
// libopenvgu11u.def). O1: the 2010 libopenvgu_sw facade (sfopenvg/openvgu/vgu.cpp) over sflibopenvgrefimpl.
#include <vg/openvguids.hrh>

target          libOpenVGU.dll
targettype      dll
uid             KUidSharedDllUidValue KUidVGUDllUidValue
CAPABILITY      ALL -tcb
vendorid        0

userinclude     ../../baseline/symbian-2010/oss.FCL.sf.os.graphics/openvg/openvgrefimplementation/sfopenvg/sfopenvg/include
OS_LAYER_SYSTEMINCLUDE
SYSTEMINCLUDE   OS_LAYER_PUBLIC_EXPORT_PATH(vg)

MACRO           __OPENVGHEADERS_USE_VG_1_1

sourcepath      ../../baseline/symbian-2010/oss.FCL.sf.os.graphics/openvg/openvgrefimplementation/sfopenvg/openvgu
source          vgu.cpp

library         euser.lib
library         sflibopenvgrefimpl.lib

SMPSAFE
