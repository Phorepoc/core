// phecamera.rss -- OURS: Camera application resource: Options = take photo / switch camera / exit
NAME PHCA

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <appinfo.rh>
#include "phecamera.hrh"

RESOURCE RSS_SIGNATURE { }
RESOURCE TBUF r_default_document_name { buf = ""; }

RESOURCE EIK_APP_INFO
	{
	menubar = r_phecamera_menubar;
	cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
	}

RESOURCE MENU_BAR r_phecamera_menubar
	{
	titles = { MENU_TITLE { menu_pane = r_phecamera_menu; } };
	}

RESOURCE MENU_PANE r_phecamera_menu
	{
	items =
		{
		MENU_ITEM { command = EPheCamCmdCapture; txt = "Take photo"; },
		MENU_ITEM { command = EPheCamCmdSwitch; txt = "Switch camera"; },
		MENU_ITEM { command = EAknSoftkeyExit; txt = "Exit"; }
		};
	}

// the launcher's entry: the caption and the icon (phecamera_icon.mif, drawn by data/make_icon.py)
RESOURCE LOCALISABLE_APP_INFO r_phecamera_localisable_app_info
	{
	short_caption = "Camera";
	caption_and_icon = CAPTION_AND_ICON_INFO { caption = "Camera"; number_of_icons = 1; icon_file = "\\resource\\apps\\phecamera_icon.mif"; };
	}
