// phecamera.mmp -- OURS: Camera, a native photo app over ECam (phecamera.cpp)
#include <platform_paths.hrh>

TARGET			phecamera.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016C60

CAPABILITY		UserEnvironment ReadUserData WriteUserData
VENDORID		0

SOURCEPATH		.
SOURCE			phecamera.cpp

START RESOURCE	phecamera.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	phecamera_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib avkon.lib eikcoctl.lib ws32.lib gdi.lib bitgdi.lib fbscli.lib
LIBRARY			ecam.lib efsrv.lib imageconversion.lib

EPOCSTACKSIZE	0x8000
EPOCHEAPSIZE	0x10000 0x2000000
