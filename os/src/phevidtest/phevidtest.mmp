// phevidtest.mmp -- OURS (VDU rung V4): plays an MP4 through CVideoPlayerUtility -> phevidctl ->
// phevdec and reports frames / fps ("PH: vid" lines). SSM_TEST=phevidtest stages it at boot. Contract: phevidtest.cpp.
TARGET			phevidtest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157D4
EPOCSTACKSIZE	0x10000
CAPABILITY		All -TCB
VENDORID		0
EPOCHEAPSIZE	0x10000 0x1000000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE
USERINCLUDE		../phevidctl
SOURCEPATH		.
SOURCE			phevidtest.cpp
LIBRARY			euser.lib efsrv.lib ws32.lib mediaclientvideo.lib mmfcontrollerframework.lib
