// phepebblesrv.mmp -- OURS: the Pebble companion service (phepebblesrv.cpp): LE link, Pebble session, SMS and missed-call
// bridge. Links the stand-in LE transport (phepebble_lestub.cpp) until the LE host provides PebbleCreateLeTransportL();
// then replace that SOURCE with the LE host's static library.
#include <platform_paths.hrh>

TARGET			phepebblesrv.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7017D01

// ReadUserData: the Inbox and the call log; LocalServices: Bluetooth
CAPABILITY		ReadUserData LocalServices NetworkServices
VENDORID		0

SOURCEPATH		.
SOURCE			phepebblesrv.cpp phepebble_lestub.cpp
SOURCE			phepebble_codec.cpp phepebble_ppogatt.cpp phepebble_session.cpp

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib efsrv.lib estor.lib charconv.lib tzclient.lib msgs.lib logcli.lib logwrap.lib

EPOCSTACKSIZE	0x6000
