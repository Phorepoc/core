// phescreenlaunch.mmp -- OURS: start an app on WSERV screen n / move the key focus to screen n (see phescreenlaunch.cpp)
TARGET			phescreenlaunch.exe
TARGETTYPE		exe
UID				0x1000007a 0xE701573A

// WriteDeviceData: RWsSession::SetFocusScreen (WSERV CLIENT.CPP checks it)
CAPABILITY		WriteDeviceData

OS_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			phescreenlaunch.cpp

// the window registry client (header only, core os/inc/phorepoc): "window" raises an app already shown as a window instead of starting it again
USERINCLUDE		../../inc/phorepoc

LIBRARY			euser.lib ws32.lib apgrfx.lib apparc.lib hal.lib efsrv.lib

VENDORID		0
