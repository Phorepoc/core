// pheextcmd.mmp -- OURS: SSM custom command that runs a System Startup Extension plug-in (pheextcmd.cpp)
TARGET			pheextcmd.dll
TARGETTYPE		dll
UID				0x1000008D 0xE70157F3
CAPABILITY		all -tcb
VENDORID		0

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE
SOURCEPATH		.
