// eshell_loc.rss -- OURS: the launcher entry (caption + icon) of the command shell, eshell.exe
NAME ESHL

#include <uikon.rh>
#include <appinfo.rh>

// apparc checks the signature before it reads the registration's hidden flag and the rest
RESOURCE RSS_SIGNATURE { }

RESOURCE LOCALISABLE_APP_INFO r_eshell_localisable_app_info
	{
	short_caption = "Shell";
	caption_and_icon = CAPTION_AND_ICON_INFO { caption = "Shell"; number_of_icons = 1; icon_file = "\\resource\\apps\\eshell_icon.mbm"; };
	}
