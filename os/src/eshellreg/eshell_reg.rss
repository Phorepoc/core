// eshell_reg.rss -- OURS: registration of the real eshell.exe (UID3 0x101F7AE7) with apparc: a caption and an icon
// for the task switcher and anything that lists it. Hidden from the menu (2026-11-06): Terminal is the user's shell;
// eshell stays for the text-shell images and scripts that start it by name
#include <appinfo.rh>
#include <eshell_loc.rsg>

UID2 KUidAppRegistrationResourceFile
UID3 0x101F7AE7

RESOURCE APP_REGISTRATION_INFO
	{
	app_file = "eshell";
	localisable_resource_file = "\\resource\\apps\\eshell_loc";
	localisable_resource_id = R_ESHELL_LOCALISABLE_APP_INFO;
	hidden = KAppIsHidden;
	}
