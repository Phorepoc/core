// coneapp.mmp -- OURS: minimal CONE (control environment) application, no Uikon
TARGET			coneapp.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015702

CAPABILITY		all -tcb

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE_SYMBIAN

SOURCEPATH		.
SOURCE			coneapp.cpp

LIBRARY			euser.lib ws32.lib gdi.lib cone.lib

VENDORID		0
