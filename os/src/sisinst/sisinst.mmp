// sisinst.mmp -- OURS (X4.86): silent SIS install through the real S60 installer; the SWI regression test
TARGET			sisinst.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015716
CAPABILITY		TrustedUI AllFiles   // AllFiles: SWInstSession requires it of a silent installer that allows untrusted packages
VENDORID		0

OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			sisinst.cpp
LIBRARY			euser.lib swinstcli.lib
