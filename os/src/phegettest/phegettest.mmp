// phegettest.mmp -- OURS: the software-source tests of the download engine (phegettest.cpp), over the engine itself
#include <platform_paths.hrh>

TARGET			phegettest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157FB
CAPABILITY		NetworkServices AllFiles
VENDORID		0

SOURCEPATH		.
SOURCE			phegettest.cpp
SOURCEPATH		../pheget
SOURCE			pheget_engine.cpp phejson.cpp

USERINCLUDE		. ../pheget
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib efsrv.lib bafl.lib esock.lib http.lib inetprotutil.lib hash.lib swinstcli.lib
