// mixtest.mmp -- OURS (audio A0/Q0): two concurrent audio clients, the mixing test
TARGET			mixtest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157A0
CAPABILITY		MultimediaDD UserEnvironment
VENDORID		0
EPOCHEAPSIZE	0x20000 0x400000
EPOCSTACKSIZE	0x14000

OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			mixtest.cpp
LIBRARY			euser.lib efsrv.lib mediaclientaudio.lib mediaclientaudiostream.lib
