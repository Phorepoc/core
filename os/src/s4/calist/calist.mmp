// calist.mmp -- OURS (S4.5): the content-arsenal checkpoint (include paths come from registry/components_s4.py)
TARGET			calist.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7015D01
CAPABILITY		None
VENDORID		0
EPOCSTACKSIZE	0x14000
EPOCHEAPSIZE	0x20000 0x800000

OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			calist.cpp

STATICLIBRARY	qtmain.lib
LIBRARY			caclient.lib QtCore.lib libc.lib libpthread.lib euser.lib
