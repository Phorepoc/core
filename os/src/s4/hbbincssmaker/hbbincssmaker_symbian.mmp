// hbbincssmaker_symbian.mmp -- OURS (S4.4b): Orbit's CSS -> cssbin tool, built for the TARGET.
// The cssbin is a raw dump of the theme server's shared-memory structures, so it must be made by code with the
// target's ABI (x32: 32-bit pointers, 8-byte-aligned 64-bit types, the target Qt's qreal). The source list is
// hb-src/src/hbtools/hbbincssmaker/hbbincssmaker.pro's; the TARGET name is the one hbsharedmemorymanager_p.cpp
// recognises (BIN_CSS_APP_SYMBIAN: it makes the chunk as the tool's, not the server's). Run on the booted image by
// tools/phorepoc-s4/make_cssbin.sh; the output is copied off the C: disk into the ROM data.
TARGET			hbbincssmaker_symbian.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7015D00
CAPABILITY		None
VENDORID		0
EPOCSTACKSIZE	0x14000
EPOCHEAPSIZE	0x20000 0x4000000

MACRO			UNICODE QT_KEYPAD_NAVIGATION QT_SOFTKEYS_ENABLED QT_USE_MATH_H_FLOATS
MACRO			HB_GESTURE_FW HB_EFFECTS QT_QCHAR_CONSTRUCTOR SYMBIAN_TARGET_ICON_CACHE_SIZE HB_NVG_CS_ICON
MACRO			HB_BOOTSTRAPPED HB_BIN_CSS QT_NO_DEBUG

OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		../../../../qt48/hb-src/src/hbtools/hbbincssmaker
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/core
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/theme
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/cssparser
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/utils
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/gui
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/image
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/style
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/feedback
USERINCLUDE		../../../../qt48/hb-src/src/hbcore/layouts

SOURCEPATH		../../../../qt48/hb-src/src/hbcore/core
SOURCE			hbhash_p.cpp hbmemorymanager_p.cpp hbsharedmemorymanager_p.cpp hbsplaytreeallocator_p.cpp
SOURCE			hbmultisegmentallocator_p.cpp hbvariant_p.cpp hbstring_p.cpp hbsharedcache.cpp hblayoutparameters.cpp
SOURCEPATH		../../../../qt48/hb-src/src/hbcore/cssparser
SOURCE			hbcssparser_p.cpp hbexpressionparser_p.cpp hblayeredstyleloader_p.cpp hbwidgetstyleloader_p.cpp
SOURCE			hbstyleselector_p.cpp
SOURCEPATH		../../../../qt48/hb-src/src/hbcore/utils
SOURCE			hbwidgetloader.cpp hbwidgetloaderactions_p.cpp hbwidgetloadersyntax_p.cpp hbxmlloaderbaseactions_p.cpp
SOURCE			hbxmlloaderabstractsyntax_p.cpp hbxmlloaderbasesyntax_p.cpp hbxmlloaderabstractactions_p.cpp
SOURCEPATH		../../../../qt48/hb-src/src/hbtools/hbbincssmaker
SOURCE			main.cpp hbcssconverterutils.cpp hboffsetmapbuilder.cpp

STATICLIBRARY	qtmain.lib
LIBRARY			QtSvg.lib QtNetwork.lib QtGui.lib QtCore.lib libc.lib libpthread.lib euser.lib
