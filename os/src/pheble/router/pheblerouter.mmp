// pheblerouter.mmp -- OURS (BLE plan rung 3): the HCI router, an HCTL plug-in that wraps the board's HCTL
// (pheblerouter.ini: inner_hctl_uid) and hands LE traffic to the LE host (pheblehost.dll). A board turns it on by
// naming its implementation 0xE7015E11 as hctl_uid in corehci_symbian.ini.
TARGET			pheblerouter.dll
TARGETTYPE		PLUGIN
UID				0x10009d8d 0xE7015E12
VENDORID		0x70000001
CAPABILITY		CommDD PowerMgmt ReadDeviceData WriteDeviceData TrustedUI ProtServ NetworkControl NetworkServices LocalServices ReadUserData WriteUserData

SOURCEPATH		.
RESOURCE		pheblerouter.rss
SOURCE			pheblerouter.cpp

USERINCLUDE		../inc
OS_LAYER_SYSTEMINCLUDE_SYMBIAN

LIBRARY			euser.lib efsrv.lib ecom.lib hctl_base.lib pheblehost.lib

NOEXPORTLIBRARY
UNPAGED
SMPSAFE
