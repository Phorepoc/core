// pheblehost.mmp -- OURS (BLE plan): the LE host -- Apache NimBLE 1.9.0 (os/third_party/nimble, Apache-2.0) on the
// Symbian NPL (port/), its custom HCI transport bound to the HCI router (pheblerouter.dll loads this DLL), the bond
// store and the "!PheBle" server. Loaded into the Bluetooth stack's process (c32exe).
TARGET			pheblehost.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015E10
CAPABILITY		CommDD PowerMgmt ReadDeviceData WriteDeviceData TrustedUI ProtServ NetworkControl NetworkServices LocalServices ReadUserData WriteUserData
VENDORID		0
EPOCALLOWDLLDATA
DEFFILE			pheblehost.def

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		../inc ../port/include
USERINCLUDE		../../../third_party/nimble/nimble/include
USERINCLUDE		../../../third_party/nimble/nimble/host/include
USERINCLUDE		../../../third_party/nimble/nimble/host/util/include
USERINCLUDE		../../../third_party/nimble/nimble/host/services/gap/include
USERINCLUDE		../../../third_party/nimble/nimble/host/services/gatt/include
USERINCLUDE		../../../third_party/nimble/nimble/host/store/ram/include
USERINCLUDE		../../../third_party/nimble/nimble/transport/include
USERINCLUDE		../../../third_party/nimble/porting/nimble/include
USERINCLUDE		../../../third_party/nimble/ext/tinycrypt/include

SOURCEPATH		.
SOURCE			pheblehost.cpp pheblestore.cpp pheblesrv.cpp phebleops.cpp
SOURCEPATH		../port/src
SOURCE			npl_symbian.cpp
SOURCEPATH		../../../third_party/nimble/nimble/host/src
