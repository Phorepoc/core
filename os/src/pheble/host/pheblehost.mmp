SOURCE			ble_sm_lgcy.c
SOURCE			ble_sm_sc.c
SOURCE			ble_store.c
SOURCE			ble_store_util.c
SOURCE			ble_uuid.c
SOURCEPATH		../../../third_party/nimble/nimble/host/util/src
SOURCE			addr.c
SOURCEPATH		../../../third_party/nimble/nimble/host/services/gap/src
SOURCE			ble_svc_gap.c
SOURCEPATH		../../../third_party/nimble/nimble/host/services/gatt/src
SOURCE			ble_svc_gatt.c
