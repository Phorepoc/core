// phestore.mmp -- OURS: the download app's UI ("Get apps"; phestore.cpp) over the pheget engine (../pheget)
#include <platform_paths.hrh>

TARGET			phestore.exe
TARGETTYPE		exe
UID				0x100039CE 0xE70157FA

CAPABILITY		TrustedUI NetworkServices
VENDORID		0
EPOCHEAPSIZE	0x10000 0x1000000

SOURCEPATH		.
SOURCE			phestore.cpp
SOURCEPATH		../pheget
SOURCE			pheget_engine.cpp phejson.cpp

SOURCEPATH		.
START RESOURCE	phestore.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	phestore_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		. ../pheget
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib eikcoctl.lib eikctl.lib eikdlg.lib avkon.lib aknskins.lib
LIBRARY			efsrv.lib bafl.lib charconv.lib esock.lib http.lib inetprotutil.lib hash.lib swinstcli.lib

EPOCSTACKSIZE	0x8000
