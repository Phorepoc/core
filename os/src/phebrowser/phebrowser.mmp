// phebrowser.mmp -- OURS: the browser frontend (custom-drawn CONE UI) over any engine implementing
// The seam header comes from the webengine repository (a layer: its os/inc is laid over this tree).
// phorepoc/phewebengine.h. PHEBROWSER_DUMMY compiles in the placeholder engine (pb_dummy.cpp) for development;
// real engines (WebKit, NetSurf) are separate packages found at runtime.
#include <platform_paths.hrh>

TARGET			phebrowser.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016B20

// The user capabilities only: an engine plug-in DLL must carry at least the caps of the process that loads it, and an
// engine installed from a store/self-signed SIS can only have these. More here would make such engines unloadable.
CAPABILITY		NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment
VENDORID		0
EPOCHEAPSIZE	0x10000 0x1000000

MACRO			PHEBROWSER_DUMMY

SOURCEPATH		.
SOURCE			phebrowser.cpp pb_dummy.cpp pb_enginehost.cpp

SOURCEPATH		.
START RESOURCE	phebrowser.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	phebrowser_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		. ../../inc
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib apgrfx.lib cone.lib eikcore.lib eikcoctl.lib eikctl.lib eikdlg.lib avkon.lib
LIBRARY			ecom.lib efsrv.lib fbscli.lib gdi.lib ws32.lib bitgdi.lib aknskins.lib charconv.lib etext.lib

EPOCSTACKSIZE	0x8000
