// phetelaudio.mmp -- OURS (telephony T1): the telephony audio routing server host + accept-all policy (see phetelaudio.cpp)
TARGET			phetelaudio.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015731
CAPABILITY		All -TCB
VENDORID		0

OS_LAYER_SYSTEMINCLUDE
SYSTEMINCLUDE	/epoc32/include/mw
SOURCEPATH		.
SOURCE			phetelaudio.cpp
LIBRARY			euser.lib telephonyaudiorouting.lib telephonyaudioroutingmanager.lib
