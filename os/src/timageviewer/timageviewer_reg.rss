		{
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/jpeg"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/jpg"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/jp2"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/tiff"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-wmf"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/ico"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/gif"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/bmp"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-bmp"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-bitmap"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-xbitmap"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-win-bitmap"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/x-windows-bmp"; },
		DATATYPE { priority = EDataTypePriorityNormal; type = "image/ms-bmp"; },
