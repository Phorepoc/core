#include <appinfo.rh>
#include <timageviewer.rsg>

UID2 KUidAppRegistrationResourceFile
UID3 0x101F45EA

RESOURCE APP_REGISTRATION_INFO
	{
	app_file = "timageviewer";
	localisable_resource_file = "\\resource\\apps\\timageviewer";
	localisable_resource_id = R_TIMG_LOCALISABLE_APP_INFO;
	embeddability = KAppNotEmbeddable;
	newfile = KAppDoesNotSupportNewFile;
