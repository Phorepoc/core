// openwfc_ri_displaychannel.mmp -- OURS (2026-10-09): the 2010 OpenWF-C "RI display" adapter over RDisplayChannel
// (oss.FCL.sf.os.graphics/graphicscomposition/openwfc_ri_displaychannel) with pipelined posts: UpdateDisplay() waits
// for the PREVIOUS post before posting the next, so libWFC composes the next frame while a post waits for its vblank
// (needs 3 composition buffers: src/phorepoc-arm/a64/display/lddinc/display.h). Same UIDs, exports and capabilities
// as the 2010 build (emitter/components.py "openwfc_ri_display" carries the def).
TARGET			openwfc_ri_displaychannel.dll
TARGETTYPE		dll
UID				0x2002BC57 0x2002BC59
CAPABILITY		PowerMgmt ReadDeviceData WriteDeviceData ProtServ
NOEXPORTLIBRARY

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
USERINCLUDE		.

LIBRARY			euser.lib hal.lib
LIBRARY			WFCinterop.lib

SOURCEPATH		.
SOURCE			openwfc_ri_displaychannel.cpp

SMPSAFE
