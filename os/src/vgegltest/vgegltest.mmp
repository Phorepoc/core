// vgegltest.mmp -- OURS: OpenVG O1 test (see vgegltest.cpp): standard libEGL + libOpenVG/libOpenVGU vs the reference
TARGET			vgegltest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157A3
CAPABILITY		None
VENDORID		0

EPOCHEAPSIZE	0x100000 0x1000000
EPOCSTACKSIZE	0x10000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
SYSTEMINCLUDE	/epoc32/include/vg
MACRO			__OPENVGHEADERS_USE_VG_1_1

SOURCEPATH		.
SOURCE			vgegltest.cpp

LIBRARY			euser.lib libEGL.lib libOpenVG.lib libOpenVGU.lib

SMPSAFE
