<?xml version="1.0" encoding="UTF-8"?>
<layers>
	<comment>Copyright The Phorepoc Authors. SPDX-License-Identifier: Apache-2.0</comment>
	<comment>The view being left (input1, stored at BeginFullScreen) shrinks and fades out over the view returned to.</comment>
	<visual src="Item">
	</visual>
	<visual src="input1" opaque="true">
		<param name="opacity" type="anim">
			<duration>0.24</duration>
			<style>inquad</style>
			<keyframe at="0.0">1.0</keyframe>
			<keyframe at="1.0">0.0</keyframe>
		</param>
		<param name="scale_x" type="anim">
			<duration>0.24</duration>
			<style>inquad</style>
			<keyframe at="0.0">1.0</keyframe>
			<keyframe at="1.0">0.90</keyframe>
		</param>
		<param name="scale_y" type="anim">
			<duration>0.24</duration>
			<style>inquad</style>
			<keyframe at="0.0">1.0</keyframe>
			<keyframe at="1.0">0.90</keyframe>
		</param>
		<param name="scale_origin_x" ref="visual.width">0.5</param>
		<param name="scale_origin_y" ref="visual.height">0.5</param>
	</visual>
</layers>
